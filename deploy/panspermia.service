# The game server (public alpha, P6b): one Node process behind Caddy. Installed by provision.sh.
# Tuning without a commit: /etc/panspermia.env (MAX_ROOMS=…), then `systemctl restart panspermia`.
[Unit]
Description=Panspermia game server
After=network-online.target
Wants=network-online.target

[Service]
User=panspermia
WorkingDirectory=/opt/panspermia/server
ExecStart=/usr/bin/node src/index.ts
Environment=NODE_ENV=production PORT=2567 HOST=127.0.0.1 HALL_DB=/var/lib/panspermia/hall.db
EnvironmentFile=-/etc/panspermia.env
# /var/lib/panspermia: the Hall of Fame, kept across deploys
StateDirectory=panspermia
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
